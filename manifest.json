{
  "manifest_version": 3,
  "name": "Soletra — Libras",
  "version": "0.3.0",
  "description": "Reconhece sinais estáticos do alfabeto de Libras pela câmera e compõe texto pesquisável. Processamento 100% local, sem envio de vídeo.",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "storage",
    "search"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Soletra — abrir painel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
